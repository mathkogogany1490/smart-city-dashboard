# 로컬 uvicorn용. Docker Compose는 이 값을 postgres 서비스 주소로 덮어씁니다.
DATABASE_URL=postgresql+psycopg://USER@127.0.0.1:5432/smart_city

# Docker Compose
HTTP_PORT=8088
BACKEND_PORT=8020
POSTGRES_PORT=5434
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity
POSTGRES_DB=smart_city
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REALTIME_INTERVAL_SECONDS=8

# 선택. 값이 없으면 대체 데이터로 동작합니다.
WEATHER_API_KEY=
YOUTUBE_API_KEY=
MOLIT_API_KEY=
WEATHER_LATITUDE=37.3804
WEATHER_LONGITUDE=126.8031

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
